# media-watch reads these from the environment. In Hermes they come from ~/.hermes/.env
# (the plugin uses Hermes' profile-aware secret lookup). Never commit a real .env.

# Required
OPENROUTER_API_KEY=

# Optional overrides
# MEDIA_WATCH_MODEL_NORMAL=google/gemini-3.8-flash
# MEDIA_WATCH_MODEL_HIGH=google/gemini-3.1-pro-preview
# MEDIA_WATCH_MODEL_FAST=google/gemini-3.1-flash-lite
# MEDIA_WATCH_FALLBACK_MODEL=qwen/qwen3.8-omni-flash   # empty string disables fallback
# MEDIA_WATCH_MAX_SECONDS=600
# MEDIA_WATCH_PROXY_FPS=15   # frame-rate cap for the proxy sent to the model
# MEDIA_WATCH_HOME=~/.hermes/cache/media-watch
# MEDIA_WATCH_COOKIES=~/.config/media-watch/cookies.txt  # Netscape format, chmod 600
